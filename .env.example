# Copy to .env and fill in. Never commit .env (it is gitignored and excluded from the Docker image).

# --- required -----------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...

# --- optional (defaults live in app/config.py) ---------------------------------------------------
# Comma-separated OpenRouter model ids, tried in order (fallback chain)
OPENROUTER_MODELS=deepseek/deepseek-v4-flash-0731,openai/gpt-5.6-luna
# Cost guard: paid models are only ever called if listed here; ":free" ids are always allowed
ALLOWED_PAID_MODELS=deepseek/deepseek-v4-flash-0731,openai/gpt-5.6-luna
# Public URL of the deployment (sent to OpenRouter as HTTP-Referer) and the source-code link in the UI
APP_PUBLIC_URL=
REPO_URL=
# Answer the UI's 6 suggested questions at startup (~$0.002 per restart with the default models, measured)
PREWARM_CACHE=false
# Cross-encoder re-ranker: on by default; set false on tiny CPUs (Render free = 0.1 CPU)
USE_RERANKER=true
ONNX_THREADS=2
# Per-IP limit on /api/chat
RATE_LIMIT=10/minute
